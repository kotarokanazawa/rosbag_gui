<?xml version="1.0"?>
<package format="2">
  <name>rosbag_gui</name>
  <version>1.0.1</version>
  <description>GUI tool for ROS1 rosbag save, playback, CSV conversion, compression, and presets.</description>

  <maintainer email="user@example.com">user</maintainer>
  <license>MIT</license>

  <buildtool_depend>catkin</buildtool_depend>

  <exec_depend>rospy</exec_depend>
  <exec_depend>rosbag</exec_depend>
  <exec_depend>rostopic</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>python3-rospkg</exec_depend>
  <exec_depend>python3-pyqt5</exec_depend>
</package>
