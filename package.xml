<?xml version="1.0"?>
<package format="3">
  <name>rosbag_gui</name>
  <version>2.0.0</version>
  <description>ROS 2 GUI tool for rosbag2 record, playback, CSV conversion, and presets.</description>
  <maintainer email="user@example.com">user</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ros2bag</exec_depend>
  <exec_depend>rosbag2_py</exec_depend>
  <exec_depend>rosidl_runtime_py</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>python3-pyqt5</exec_depend>
  <exec_depend>rosbag2_compression</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
